{
  "name": "stock-next",
  "version": "1.0.0",
  "private": true,
  "description": "College Stock/Inventory Management System — Next.js + PostgreSQL port of the PHP stock app",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
