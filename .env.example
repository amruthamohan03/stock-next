# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stock_db

# Secret used to sign the session JWT (any long random string)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# App
APP_NAME=Stock Management
NODE_ENV=development

# Email (SMTP) — needed to send mail from the app's Compose page.
# For Gmail use an App Password (not your login password) with host smtp.gmail.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address shown to recipients (defaults to SMTP_USER if left blank)
MAIL_FROM=Stock Management <no-reply@example.com>
